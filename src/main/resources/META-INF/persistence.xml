<!--        </properties>-->
        <properties>
            <!-- configurações de Conexão com o MySQL -->
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />

            <!-- URL apontando para a porta padrão do MySQL (3306) e o banco tcs_treinamento -->
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/tcs_treinamento?serverTimezone=UTC" />

            <!-- credenciais de acesso ao seu MySQL (ajuste a senha) -->
            <property name="javax.persistence.jdbc.user" value="root" />
            <property name="javax.persistence.jdbc.password" value="teste123" />

            <!-- dialeto para o Hibernate traduzir o Java para o SQL específico do MySQL 8 -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect" />

            <!-- mantém a criação automática das tabelas -->
            <property name="hibernate.hbm2ddl.auto" value="update" />

            <!-- mostra o SQL gerado no console -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>